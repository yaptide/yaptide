# Stage 1: Generate SSL certificate
FROM alpine AS cert-gen

RUN apk add --no-cache openssl

WORKDIR /certs

RUN openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 \
    -subj "/C=US/ST=State/L=City/O=Organization/CN=localhost" \
    -keyout server.key -out server.crt


# Stage 2: Serve the nginx proxy
FROM nginx:1.25-alpine

# Configure Nginx to serve as the proxy
RUN rm /etc/nginx/conf.d/default.conf

# a self-signed certificate, used when docker-compose.yml mounts none (scripts/nginx_tls.sh)
COPY --from=cert-gen /certs /etc/nginx/self-signed
COPY scripts/nginx_tls.sh /docker-entrypoint.d/40-yaptide-tls.sh
RUN chmod +x /docker-entrypoint.d/40-yaptide-tls.sh

# Copy the Nginx configuration
COPY nginx.conf /etc/nginx/conf.d

EXPOSE 5000

CMD ["nginx", "-g", "daemon off;"]
